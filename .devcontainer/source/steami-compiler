#!/usr/bin/env bash
# steami-compiler : compile le programme (ou un exemple) pour la carte STeaMi.
set -euo pipefail

# shellcheck source=steami-commun.sh disable=SC1091
source "$(dirname "$0")/steami-commun.sh" 2>/dev/null || source /usr/local/lib/steami/steami-commun.sh

usage() {
    cat <<'EOT'
Usage : steami-compiler [COMPOSANT/Exemple]

Sans argument, compile votre programme (le dossier src/).
Avec un argument, compile cet exemple tel quel, sans toucher à src/
(la liste : steami-exemples).

Si la compilation réussit, firmware.bin est prêt dans .steami/ : lancez
steami-televerser pour l'envoyer sur la carte. Si elle échoue, le dernier
firmware.bin reste en place.
EOT
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac
[ "$#" -le 1 ] || die "Trop d'arguments. Usage : steami-compiler [COMPOSANT/Exemple]"

racine=$(racine_depot) || die "Lancez steami-compiler dans votre projet (un dossier qui contient platformio.ini)."
cd "$racine"

programme=src
if [ "$#" -eq 1 ]; then
    PLATFORMIO_SRC_DIR=$(dossier_exemple "$1")
    export PLATFORMIO_SRC_DIR
    # Le nom réel (COMPOSANT/Exemple), pas celui que la personne a tapé.
    programme=$(basename "$(dirname "$PLATFORMIO_SRC_DIR")")/$(basename "$PLATFORMIO_SRC_DIR")
fi

run pio run -e steami \
    || die "La compilation a échoué : corrigez la première erreur ci-dessus (fichier:ligne). Le dernier firmware.bin n'a pas changé."

mkdir -p .steami
taille=$(stat -c %s .pio/build/steami/firmware.bin)
cp .pio/build/steami/firmware.bin .steami/firmware.bin.tmp
mv .steami/firmware.bin.tmp .steami/firmware.bin
printf '{"programme": "%s", "date": "%s", "taille": %s}\n' \
    "$programme" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$taille" > .steami/firmware.json.tmp
mv .steami/firmware.json.tmp .steami/firmware.json

echo
echo "✅ $programme compilé : firmware.bin prêt (steami-televerser pour l'envoyer sur la carte)"
