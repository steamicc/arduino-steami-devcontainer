#!/usr/bin/env bash
# steami-televerser : prépare le téléversement du programme compilé vers la carte.
set -euo pipefail

# shellcheck source=steami-commun.sh disable=SC1091
source "$(dirname "$0")/steami-commun.sh" 2>/dev/null || source /usr/local/lib/steami/steami-commun.sh

usage() {
    cat <<'EOT'
Usage : steami-televerser

Prépare l'envoi du dernier programme compilé (steami-compiler) vers la carte.
Deux méthodes, au choix :
  1. la page « Téléverser » : la commande lance le serveur et affiche son
     adresse, à ouvrir dans un onglet de Chrome ou d'Edge ;
  2. le glisser-déposer : clic droit sur .steami/firmware.bin → Download,
     puis glissez le fichier sur le lecteur STEAMI.
EOT
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

racine=$(racine_depot) || die "Lancez steami-televerser dans votre projet (un dossier avec platformio.ini)."
cd "$racine"
[ -f .steami/firmware.json ] || die "Aucun programme compilé : lancez steami-compiler"

# Un échec de démarrage s'affiche ici plutôt que de laisser une adresse morte.
steami-serveur start

port="${STEAMI_PORT:-8080}"
if [ -n "${CODESPACE_NAME:-}" ] && [ -n "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-}" ]; then
    adresse="https://${CODESPACE_NAME}-${port}.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/"
else
    adresse="http://localhost:${port}/"
fi

cat <<EOT

Deux façons d'envoyer le programme sur la carte :

  Méthode 1 : la page Téléverser
    Ouvrez cette adresse dans un onglet de Chrome ou d'Edge :
    $adresse

  Méthode 2 : le glisser-déposer
    Clic droit sur .steami/firmware.bin → Download,
    puis glissez le fichier sur le lecteur STEAMI.
EOT
