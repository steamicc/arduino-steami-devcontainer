#!/usr/bin/env bash
# steami-copier : copie un exemple dans src/ pour le modifier.
set -euo pipefail

# shellcheck source=steami-commun.sh disable=SC1091
source "$(dirname "$0")/steami-commun.sh" 2>/dev/null || source /usr/local/lib/steami/steami-commun.sh

usage() {
    cat <<'EOT'
Usage : steami-copier [--remplacer] driver/Exemple

Remplace le contenu de src/ par les fichiers de l'exemple (la liste :
steami-exemples), pour que vous puissiez le modifier.
Si src/ contient des modifications pas encore sauvegardées, la commande
s'arrête : lancez steami-sauver d'abord, ou ajoutez --remplacer pour les
écraser.
EOT
}

remplacer=0
exemple=""
for a in "$@"; do
    case "$a" in
        -h|--help) usage; exit 0 ;;
        --remplacer) remplacer=1 ;;
        -*) die "Option inconnue : $a. Usage : steami-copier [--remplacer] driver/Exemple" ;;
        *) [ -z "$exemple" ] || die "Un seul exemple à la fois. Usage : steami-copier [--remplacer] driver/Exemple"
           exemple="$a" ;;
    esac
done
[ -n "$exemple" ] || die "Indiquez l'exemple à copier. Usage : steami-copier [--remplacer] driver/Exemple (la liste : steami-exemples)"

racine=$(racine_depot) || die "Lancez steami-copier dans votre projet (un dossier qui contient platformio.ini)."
cd "$racine"
source_ex=$(dossier_exemple "$exemple")

if [ "$remplacer" -eq 0 ] && git rev-parse --git-dir >/dev/null 2>&1; then
    echo "→ git status --porcelain -- src"
    modifs=$(git status --porcelain -- src)
    if [ -n "$modifs" ]; then
        die "src/ contient des modifications pas encore sauvegardées : lancez steami-sauver d'abord, ou steami-copier --remplacer $exemple pour les écraser."
    fi
fi

rm -rf src
mkdir src
# Sans les <croquis>.ino.cpp que PlatformIO laisse dans le dossier de l'exemple
# après steami-compiler : avec le .ino, ils définiraient tout en double.
tar -C "$source_ex" --exclude='*.ino.cpp' -cf - . | tar -C src -xf -
echo "✅ $exemple copié dans src/"
