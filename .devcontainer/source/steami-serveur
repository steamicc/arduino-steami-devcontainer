#!/usr/bin/env bash
# steami-serveur : démarre, arrête ou interroge le serveur de la page Téléverser.
set -euo pipefail

# shellcheck source=steami-commun.sh disable=SC1091
source "$(dirname "$0")/steami-commun.sh" 2>/dev/null || source /usr/local/lib/steami/steami-commun.sh

usage() {
    cat <<'EOT'
Usage : steami-serveur start|stop|status

Gère le serveur qui affiche la page « Téléverser » (port 8080 par défaut).
  start    lance le serveur en arrière-plan (sans effet s'il tourne déjà)
  stop     l'arrête
  status   sort avec 0 s'il tourne, avec 1 sinon
EOT
}

pidfile="${STEAMI_PID:-/tmp/steami-serveur.pid}"

# Cherche le script du serveur à côté de la commande, puis dans l'image.
script_serveur() {
    local d
    d="$(dirname "$0")"
    if [ -n "${STEAMI_SERVEUR_PY:-}" ]; then printf '%s\n' "$STEAMI_SERVEUR_PY"
    elif [ -f "$d/steami_serveur.py" ]; then printf '%s\n' "$d/steami_serveur.py"
    else printf '%s\n' /usr/local/lib/steami/steami_serveur.py
    fi
}

# Succès si le fichier pid désigne un processus steami_serveur vivant.
tourne() {
    local pid
    [ -f "$pidfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q steami_serveur
}

case "${1:-}" in
    -h|--help) usage ;;
    start)
        if tourne; then
            echo "Le serveur tourne déjà."
            exit 0
        fi
        racine=$(racine_depot) || die "Lancez steami-serveur dans votre projet (un dossier avec platformio.ini)."
        cd "$racine"
        export STEAMI_DEPOT="$racine"
        rm -f "$pidfile"
        setsid nohup python3 "$(script_serveur)" >"${STEAMI_LOG:-/tmp/steami-serveur.log}" 2>&1 </dev/null &
        echo $! > "$pidfile"
        echo "Serveur lancé (port ${STEAMI_PORT:-8080})."
        ;;
    stop)
        if tourne; then
            pid=$(cat "$pidfile")
            kill "$pid" 2>/dev/null || true
            for _ in $(seq 30); do
                [ -r "/proc/$pid/cmdline" ] || break
                sleep 0.1
            done
            echo "Serveur arrêté."
        fi
        rm -f "$pidfile"
        ;;
    status)
        tourne
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
